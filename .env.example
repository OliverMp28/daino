# Copia este archivo a .env y rellena los valores locales.
# .env está gitignorado — no lo commitees.

# ======================
# App
# ======================
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_PORT=8080
# Clave secreta de la app, base64 de 32 bytes random. Se usa para firmar
# cookies cortas (ej. la cookie HMAC de PKCE OAuth) y como defensa en
# profundidad. NO la commitees. Genera la tuya con:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_KEY=base64:CHANGE_ME_GENERATE_A_NEW_ONE
# Lifetime de la cookie DAINO_SESSID en minutos. 30 días por defecto, matchea
# el TTL del refresh_token de Vout. Si tu app necesita expiración más corta
# (ej. terminal compartida), bájalo a 120 (2h) o lo que prefieras.
SESSION_LIFETIME_MIN=43200

# ======================
# Base de datos (MariaDB)
# ======================
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=daino
DB_USER=daino
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
# Puerto expuesto al host (por si lo quieres conectar con phpMyAdmin/DataGrip)
DB_PORT_HOST=3306

# ======================
# Vite dev server
# ======================
# Daino corre Vite en :5174 a propósito — Vout usa :5173 por convención
# Laravel/sail, así que ambos pueden coexistir sin matar procesos. Cambia
# VITE_DEV_PORT si necesitas otro puerto (vite.config.js lo lee con loadEnv).
# VITE_DEV_SERVER debe apuntar al MISMO puerto: PHP lo lee y emite los
# <script type="module"> a esa URL.
# Vacía o comentada en producción para que se use el manifest.json de
# public/build/.
VITE_DEV_PORT=5174
VITE_DEV_SERVER=http://localhost:5174

# ======================
# Vout (OAuth2 IdP)
# ======================
VOUT_ISSUER=https://vout.example.com
VOUT_AUTHORIZE_URL=https://vout.example.com/oauth/authorize
VOUT_TOKEN_URL=https://vout.example.com/oauth/token
VOUT_JWKS_URL=https://vout.example.com/oauth/token/keys
VOUT_USERINFO_URL=https://vout.example.com/api/v1/user/me
VOUT_CLIENT_ID=
VOUT_CLIENT_SECRET=
VOUT_REDIRECT_URI=http://localhost:8080/auth/callback
VOUT_SCOPES=user:read
# Origen de Vout para validación postMessage cuando Daino corre embebido
VOUT_ORIGIN=https://vout.example.com

# ======================
# Uploads de MP3 del usuario
# ======================
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_MIME=audio/mpeg

# ======================
# Analizador musical en servidor (Ola 4) — servicio `analyzer` de docker-compose
# ======================
# true: al publicar, el nivel queda pendiente hasta que el servidor lo analiza
# (beats, secciones, techo de dificultad) y se publica con ese chart.
# false: se publica al instante con el chart del navegador (sin el servicio).
ANALYZER_ENABLED=true
# Hilos de PyTorch por worker, tiempo máximo por canción y memoria del contenedor.
ANALYZER_TORCH_THREADS=4
ANALYZER_JOB_TIMEOUT_SECONDS=900
ANALYZER_MEM_LIMIT=3g
