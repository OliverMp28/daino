{
    "name": "olivermp28/daino",
    "description": "Daino — audio-reactive side-scroller game, v2 rewrite sobre Vout IdP.",
    "type": "project",
    "license": "proprietary",
    "keywords": ["game", "pixijs", "audio-reactive", "oauth2"],
    "require": {
        "php": "~8.5.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "lcobucci/jwt": "^5.5",
        "vlucas/phpdotenv": "^5.6",
        "league/oauth2-client": "^2.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.3"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "scripts": {
        "migrate": "php scripts/migrate.php",
        "analyse": "phpstan analyse -l 6 app/",
        "clean:sessions": "php scripts/clean-sessions.php",
        "test": "php tests/php/run.php",
        "seed:official": "php scripts/seed-official.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
