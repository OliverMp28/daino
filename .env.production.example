# Variables de producción de Daino (docker-compose.prod.yml, Coolify).
# En Coolify se ponen en Environment Variables; este archivo es solo la lista.
# No se copia a ninguna imagen (.dockerignore excluye .env*).

# --- App ------------------------------------------------------------------------
APP_URL=https://daino.vout.tech
# Nueva para producción (no reutilizar la local). Firma la cookie de PKCE:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_KEY=
# Minutos que dura la sesión desde el último uso (30 días = el refresh token de Vout).
SESSION_LIFETIME_MIN=43200
# APP_ENV=production, APP_DEBUG=false y VITE_DEV_SERVER vacía las fija el compose.

# --- Base de datos (MariaDB compartida: base y usuario propios) -------------------
# Nombre del contenedor de MariaDB en la red de Docker (en Coolify, el de la
# instancia de base de datos; con "Connect To Predefined Network").
DB_HOST=
DB_PORT=3306
DB_DATABASE=daino
DB_USER=daino
DB_PASSWORD=

# --- Vout (OAuth2) --------------------------------------------------------------
# VOUT_ISSUER tiene que ser EXACTAMENTE el `iss` de los tokens de Vout.
VOUT_ISSUER=https://vout.tech
VOUT_AUTHORIZE_URL=https://vout.tech/oauth/authorize
VOUT_TOKEN_URL=https://vout.tech/oauth/token
VOUT_JWKS_URL=https://vout.tech/oauth/jwks
VOUT_USERINFO_URL=https://vout.tech/api/v1/user/me
# Cliente OAuth de Daino registrado en el Vout de producción.
VOUT_CLIENT_ID=
VOUT_CLIENT_SECRET=
VOUT_REDIRECT_URI=https://daino.vout.tech/auth/callback
VOUT_SCOPES=user:read
# Origen del portal que embebe Daino (postMessage y frame-ancestors).
VOUT_ORIGIN=https://vout.tech

# --- Subidas y analizador -----------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10
# true: un nivel no es público hasta que el analizador lo procesa (servicio
# daino-analyzer). false: se publica al momento con el chart del navegador.
ANALYZER_ENABLED=true
ANALYZER_TORCH_THREADS=1
ANALYZER_JOB_TIMEOUT_SECONDS=900
ANALYZER_POLL_SECONDS=5
ANALYZER_MEM_LIMIT=1200m
ANALYZER_CPUS=0.7

# --- Despliegue ---------------------------------------------------------------------
# Aplicar migraciones al arrancar el contenedor PHP.
DAINO_MIGRATE_ON_START=true
